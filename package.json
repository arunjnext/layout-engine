{
  "name": "resume-layout-engine",
  "version": "1.0.0",
  "description": "Headless library for automatic resume page splitting with TypeScript support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "resume",
    "layout",
    "page-splitting",
    "headless",
    "typescript",
    "pdf",
    "a4"
  ],
  "author": "arunjnext",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunjnext/layout-engine.git"
  },
  "homepage": "https://github.com/arunjnext/layout-engine#readme",
  "bugs": {
    "url": "https://github.com/arunjnext/layout-engine/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:vanilla": "vite --config examples/vanilla/vite.config.ts",
    "build": "tsc",
    "build:lib": "tsc --project tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
